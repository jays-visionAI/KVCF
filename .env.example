# ──────────────────────────────────────────────────────────────────────────────
#  KVCF — 환경 변수
#  이 파일은 .env.example 입니다. 실제 값은 .env 에 넣고 .env 는 커밋하지 마세요.
#  모든 키는 forgedb.cloud 콘솔 (https://forgedb.cloud) 의 프로젝트 설정 →
#  API → Connect 에서 복사할 수 있습니다.
# ──────────────────────────────────────────────────────────────────────────────

# ── ForgeDB (필수) ────────────────────────────────────────────────────────────
# API 콘솔의 베이스 URL
FORGEDB_URL=https://forgedb.cloud
# 같은 값을 클라이언트에서도 참조 (NEXT_PUBLIC_ prefix 는 브라우저 번들에 포함됨)
NEXT_PUBLIC_FORGEDB_URL=https://forgedb.cloud

# 프로젝트 슬러그 (URL 의 {projectSlug} 자리에 들어가는 값)
FORGEDB_PROJECT_ID=
NEXT_PUBLIC_FORGEDB_PROJECT_ID=

# anon 키 — 클라이언트에서 사용 가능 (RLS 가 모든 접근을 제어)
FORGEDB_ANON_KEY=
NEXT_PUBLIC_FORGEDB_ANON_KEY=

# service_role 키 — 서버 전용. **절대 NEXT_PUBLIC_ 로 노출하지 마세요.**
# 관리자 백오피스 / 마이그레이션 스크립트에서만 사용.
FORGEDB_SERVICE_ROLE_KEY=

# ── 호스팅 / 도메인 (선택) ────────────────────────────────────────────────────
# ForgeDB Static Hosting (forgedb.app) 에서 발급된 슬러그. .well-known/forge-hosting.json 의 host 와 일치해야 함.
FORGE_HOST_SLUG=kvcf-jt1bd3
# 커스텀 도메인 (apex). public/CNAME · public/.well-known/forge-hosting.json 과 같은 값을 사용합니다.
# ⚠️ apex 는 DNS 표준상 CNAME 을 걸 수 없어, 가비아 DNS 에 TXT 검증 레코드 하나
#    (_forgedb-verify) 를 추가해 소유권을 확인하면 SSL 이 자동 발급됩니다.
#    절차: forgedb/DOMAIN_SETUP.md
NEXT_PUBLIC_SITE_DOMAIN=kvcf.kr

# ── 외부 서비스 (선택) ────────────────────────────────────────────────────────
# Kakao 공유 (Open Graph 메타 태그)
NEXT_PUBLIC_KAKAO_JS_KEY=
# 분석 (GA4 / Kakao Pixel / Naver Analytics)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_KAKAO_PIXEL_ID=
NEXT_PUBLIC_NAVER_ANALYTICS_ID=
